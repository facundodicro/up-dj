# Copiá este archivo como `.env` y completá con los datos de tu proyecto Supabase.
# Sin estas variables la app corre en modo demo local (datos en el navegador).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Donaciones (botón Donar). Si se dejan vacías, se usan los valores de src/lib/config.js
# VITE_DONATE_MP_ALIAS=
# VITE_DONATE_WHATSAPP=
# Link de PayPal.me para donaciones internacionales (ej: https://paypal.me/facundo/10).
# Si está vacío, la opción "Donar desde el exterior" se oculta del modal.
# VITE_DONATE_PAYPAL_URL=
# Alternativa: email de la cuenta PayPal (se genera el link de donación automáticamente)
# VITE_DONATE_PAYPAL_EMAIL=
